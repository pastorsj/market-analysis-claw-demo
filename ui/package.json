{
  "name": "aiq-blueprint-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build && cp -R public .next/standalone/ && cp -R .next/static .next/standalone/.next/",
    "start": "HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "lint": "eslint src e2e e2e-live",
    "lint:fix": "eslint src e2e e2e-live --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "TZ=UTC vitest --no-watch",
    "test:watch": "TZ=UTC vitest",
    "test:ci": "TZ=UTC vitest run --coverage",
    "e2e": "playwright test --project=smoke",
    "e2e:visual": "e2e/visual/run.sh",
    "e2e:visual:update": "e2e/visual/run.sh --update"
  },
  "dependencies": {
    "@nvidia/foundations-react-core": "^1.13.0",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "katex": "^0.18.9",
    "mermaid": "^12.0.0",
    "motion": "^13.4.6",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.1.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-next": "^16.3.7",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.23",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
