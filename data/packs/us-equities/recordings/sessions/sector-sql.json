          "content": {
            "query": "For each SIC division, count the number of stocks and compute the median return from January 2, 2026 to March 12, 2026. Return the SIC division name/description, stock count, and median return.",
            "databaseName": "us_equities",
            "answer": "This query calculates, for each SIC division (sector), how many stocks have price data on both January 2, 2026 and March 12, 2026, and what the median price‑change return over that period is. It first finds each stock's first and last trading dates within the window, retrieves the corresponding closing prices, computes the return, then groups by sector to count distinct stocks and compute the median return using percentile_cont.",
            "sql": "WITH price_range AS (SELECT asset_id, MIN(trading_date) AS start_date, MAX(trading_date) AS end_date FROM daily_prices WHERE trading_date BETWEEN DATE '2026-01-02' AND DATE '2026-03-12' GROUP BY asset_id), returns AS (SELECT a.asset_id, a.sector, (end_close.close - start_close.close) / NULLIF(start_close.close, 0) AS ret FROM price_range pr JOIN assets a ON a.asset_id = pr.asset_id JOIN daily_prices start_close ON start_close.asset_id = pr.asset_id AND start_close.trading_date = pr.start_date JOIN daily_prices end_close ON end_close.asset_id = pr.asset_id AND end_close.trading_date = pr.end_date) SELECT sector, COUNT(DISTINCT asset_id) AS stock_count, percentile_cont(0.5) WITHIN GROUP (ORDER BY ret) AS median_return FROM returns GROUP BY sector ORDER BY sector;",
